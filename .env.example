# Copy this file to .env.local and add your actual API keys
# NEVER commit .env.local to git!

# Option 1: ElevenLabs (Recommended - Best Quality)
# Get your key at: https://elevenlabs.io/app/settings/api-keys
# Free tier: 10,000 characters/month
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Option 2: Google Cloud Text-to-Speech
# Get your key at: https://console.cloud.google.com/apis/credentials
# Free tier: 1 million characters/month
GOOGLE_TTS_API_KEY=your_google_api_key_here

# Note: You only need ONE of the above APIs
# The app will try ElevenLabs first, then fall back to Google
# If neither is configured, the app uses the free Web Speech API
